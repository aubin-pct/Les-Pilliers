# Clé d'authentification Tailscale (admin → Settings → Keys → Generate auth key ; ni éphémère ni réutilisable suffit)
TS_AUTHKEY=tskey-auth-XXXXXXXXXXXX
# Jeton de synchronisation, à coller dans l'appli sur chaque appareil. Génère-le avec : openssl rand -hex 24
SYNC_TOKEN=remplace-moi-par-48-caracteres-hexadecimaux
